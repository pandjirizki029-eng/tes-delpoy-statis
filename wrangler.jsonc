{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paas-express-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paas-students-db",
      "database_id": "23bcee61-d962-4ecc-885d-ef722c17cb5c"
    }
  ]
}
